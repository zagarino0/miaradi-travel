# MIARADI-TRAVEL — limits for gallery image/video uploads.
# These directives apply when PHP runs as an Apache module (XAMPP mod_php).
# On PHP-FPM/FastCGI, configure the equivalent values in the hosting PHP settings.
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 120M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

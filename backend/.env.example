# Copy to a private local/OVH environment file; never commit real credentials.
APP_ENV=development
APP_DEBUG=0
APP_URL=https://example.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=miaradi_travel
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_private_password

# Configure mail delivery with OVH/provider details before enabling quote emails.
MAIL_FROM=no-reply@example.com
MAIL_TO=contact@example.com
